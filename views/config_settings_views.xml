<odoo>
    <data>
        <record id="res_config_settings_view_form_maya_booking" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.maya.booking</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">

                <xpath expr="//app[@name='general_settings']" position="after">

                    <app string="Maya | Booking" name="maya_booking">

                        <block title="Valores por defecto para reservas">

                            <setting string="Máximo sesiones consecutivas" 
                                     help="Valor que se asignará por defecto al crear un nuevo Tipo de Reserva.">
                                <field name="num_max_session_consecutive"/>
                            </setting>

                            <setting string="Días de antelación" 
                                     help="Número de días de antelación que se sugerirán por defecto en los nuevos Tipos de Reserva.">
                                <field name="max_days_in_advance"/>
                            </setting>

                        </block>

                    </app>

                </xpath>

            </field>
        </record>
    </data>
</odoo>